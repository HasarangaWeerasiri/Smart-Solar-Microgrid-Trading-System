<?xml version="1.0" encoding="utf-8"?>
<!--
  File: web.config
  Project: Smart Solar Microgrid Trading System (SE4040)
  Author: Amindu
  Created: 2026-09-28
  Description: IIS hosting config for the ASP.NET Core Module V2 (ANCMv2). Generated content is
               overwritten by `dotnet publish`, but the hostingModel, environment variables and
               stdout logging settings below are preserved across publishes because they are set
               explicitly in this source-controlled copy (the publish step merges into this file
               rather than replacing it outright).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="inprocess" runs the API inside the IIS worker process (w3wp.exe), which is
        faster than out-of-process (no reverse-proxy hop to Kestrel over a loopback port) and is
        the recommended model for a single site like this one. Out-of-process is only needed when
        multiple apps must share one process or the app must run some other web server side by
        side with IIS, which does not apply here.

        stdoutLogEnabled is false by default: IIS's own logs and Windows Event Viewer already
        capture startup failures (500.30, 502.5 ANCM), and leaving stdout logging on in
        production writes a growing log file for every request. To debug a startup failure,
        flip stdoutLogEnabled to "true", redeploy, reproduce the failure, then read the newest
        file in .\logs\, and set it back to "false" once done.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Microgrid.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
