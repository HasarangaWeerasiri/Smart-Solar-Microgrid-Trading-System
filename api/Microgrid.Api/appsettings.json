{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDB": "<set in appsettings.Development.json>"
  },
  "DatabaseSettings": {
    "DatabaseName": "SolarMicrogridDB"
  },
  "Jwt": {
    "Issuer": "MicrogridApi",
    "Audience": "MicrogridClients",
    "Key": "<set in appsettings.Development.json>",
    "ExpiryMinutes": 480
  },
  "Seed": {
    "BackofficeEmail": "admin@microgrid.lk",
    "BackofficeFullName": "System Administrator",
    "BackofficePassword": "Admin@123"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
