<?xml version="1.0" encoding="utf-8"?>
<!--
  File: IISProfile.pubxml
  Project: Smart Solar Microgrid Trading System (SE4040)
  Author: Amindu
  Created: 2026-09-28
  Description: Folder publish profile for IIS. Run with:
                 dotnet publish -c Release -p:PublishProfile=IISProfile
               Produces a self-contained-framework-dependent folder under bin\Release\net10.0\publish
               that can be copied straight to the IIS site's physical path. Contains no secrets;
               real config values live only in the git-ignored appsettings.Production.json that
               is copied into the publish folder alongside this build output on the server.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <PublishDir>bin\Release\net10.0\publish\</PublishDir>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Produce web.config automatically and keep any hand edits in the checked-in copy. -->
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
  </PropertyGroup>
</Project>
