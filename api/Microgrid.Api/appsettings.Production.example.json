{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MongoDB": "mongodb+srv://realUser:realPassword@your-cluster.mongodb.net/?retryWrites=true&w=majority"
  },
  "DatabaseSettings": {
    "DatabaseName": "SolarMicrogridDB"
  },
  "Jwt": {
    "Issuer": "MicrogridApi",
    "Audience": "MicrogridClients",
    "Key": "replace-this-with-your-own-long-random-secret-at-least-32-chars",
    "ExpiryMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "https://your-web-app-hostname-or-ip" ]
  },
  "Seed": {
    "SampleData": false
  }
}
