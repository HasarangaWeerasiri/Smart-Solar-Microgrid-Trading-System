<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        File: themes.xml
        Project: Smart Solar Microgrid Trading System (SE4040)
        Author: UI redesign
        Created: 2026-09-29
        Description: App theme for the dark fintech-style redesign. Forced dark (not
                     DayNight) so the app always matches the wireframes regardless of the
                     device's system theme. Sets Poppins as the default font and wires the
                     gradient button / rounded card / filled input styles from styles.xml as
                     the defaults, so most existing layouts pick up the new look without
                     per-view changes.
    -->
    <style name="Theme.Microgrid" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Brand gradient colours -->
        <item name="colorPrimary">@color/brand_indigo</item>
        <item name="colorPrimaryVariant">@color/brand_indigo_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_cyan</item>
        <item name="colorSecondaryVariant">@color/brand_teal</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Surfaces and background -->
        <item name="android:windowBackground">@color/color_bg</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:statusBarColor">@color/color_bg</item>
        <item name="android:navigationBarColor">@color/color_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Default widget styles -->
        <item name="materialButtonStyle">@style/Widget.Microgrid.Button.Primary</item>
        <item name="editTextStyle">@style/Widget.Microgrid.EditText</item>
        <item name="materialCardViewStyle">@style/Widget.Microgrid.Card</item>
    </style>
</resources>
