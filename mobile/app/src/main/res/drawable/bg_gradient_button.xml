<?xml version="1.0" encoding="utf-8"?>
<!--
    File: bg_gradient_button.xml
    Project: Smart Solar Microgrid Trading System (SE4040)
    Author: UI redesign
    Created: 2026-09-29
    Description: Indigo-to-cyan gradient fill with fully rounded corners for primary buttons.
                 The rounded corners also become the button's elevation shadow shape.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/brand_cyan"
        android:startColor="@color/brand_indigo"
        android:type="linear" />
    <corners android:radius="28dp" />
</shape>
