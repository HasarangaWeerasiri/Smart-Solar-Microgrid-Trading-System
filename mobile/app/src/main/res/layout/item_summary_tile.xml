<?xml version="1.0" encoding="utf-8"?>
<!--
    File: item_summary_tile.xml
    Project: Smart Solar Microgrid Trading System (SE4040)
    Author: Member D
    Created: 2026-09-28
    Description: One count tile on the prosumer dashboard (Pending, Approved, Completed or
                 Approved upcoming). Inflated four times into the two tile rows in
                 activity_prosumer_dashboard.xml. The value is set from GET
                 /api/reservations/summary only - never computed or hard-coded.
                 (Restyled 2026-09-29: rounded dark card, cyan accent value.)
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tile_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="—"
            android:textColor="@color/brand_cyan"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
