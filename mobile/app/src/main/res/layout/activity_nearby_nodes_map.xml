<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_nearby_nodes_map.xml
    Project: Smart Solar Microgrid Trading System (SE4040)
    Author: Member D
    Created: 2026-09-28
    Description: Map of nearby solar microgrid stations, with a custom dark header.
                 (Restyled 2026-09-29: header/content unified into the dark fintech theme.)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_gradient_button"
        android:elevation="6dp"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <!-- Back button -->
        <TextView
            android:id="@+id/button_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:fontFamily="@font/poppins_bold" />

        <!-- Title -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Solar Microgrid"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Grid Nodes Map"
                android:textColor="#E0E7FF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Solar indicator -->
        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="@color/brand_amber"
            android:gravity="center"
            android:text="☀"
            android:textColor="@color/color_bg"
            android:textSize="22sp" />

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nearby Grid Nodes"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/poppins_bold"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="View available solar microgrid stations"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="#1F2D3D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="@color/brand_teal"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_station_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Loading grid nodes..."
                android:textColor="@color/brand_teal"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================= LOADING ================= -->

    <ProgressBar
        android:id="@+id/progress_map"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />


    <!-- ================= ERROR MESSAGE ================= -->

    <TextView
        android:id="@+id/text_map_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"
        android:background="#2A1A1A"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@color/error_text"
        android:textSize="13sp"
        android:visibility="gone" />


    <!-- ================= MAP ================= -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:background="@color/color_surface_alt">

        <fragment
            android:id="@+id/map_fragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
