<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_prosumer_dashboard.xml
    Project: Smart Solar Microgrid Trading System (SE4040)
    Author: Member D
    Created: 2026-09-28
    Description: The prosumer dashboard: four count tiles, a Current bookings / Booking history
                 tab pair, a search box and date range filter, and the booking list itself.
                 (Restyled 2026-09-29: dark theme.)
                 (Reworked 2026-09-29: CoordinatorLayout + AppBarLayout so the summary tiles
                 collapse out of view as the booking list is scrolled down and slide back in as
                 soon as the user scrolls up, while the tabs/search/date filter bar stays pinned
                 under them at all times.)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_bg"
        app:elevation="0dp">

        <!-- Collapsible: title, subtitle, offline banner and the four summary tiles. Scrolls
             away when the list below is scrolled down, and reappears the moment the user
             scrolls back up (enterAlways), without needing to reach the top of the list. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_title"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_dashboard_refresh"
                    style="@style/Widget.Microgrid.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/refresh"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_subtitle"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_offline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/offline_banner_bg"
                android:padding="10dp"
                android:text="@string/dashboard_offline_banner"
                android:textColor="@color/offline_banner_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Summary tiles: Pending, Approved, Completed, Approved upcoming - all four from
                 GET /api/reservations/summary. Never computed here. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tile_pending"
                    layout="@layout/item_summary_tile" />

                <include
                    android:id="@+id/tile_approved"
                    layout="@layout/item_summary_tile" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tile_completed"
                    layout="@layout/item_summary_tile" />

                <include
                    android:id="@+id/tile_approved_upcoming"
                    layout="@layout/item_summary_tile" />
            </LinearLayout>

        </LinearLayout>

        <!-- Pinned: current/history tabs, search and the date filter bar. Never scrolls away,
             so the user can always search or switch tabs regardless of list scroll position. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_bg"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:tabMode="fixed">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_current" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_history" />
            </com.google.android.material.tabs.TabLayout>

            <EditText
                android:id="@+id/input_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints=""
                android:hint="@string/search_hint"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_date_from"
                    style="@style/Widget.Microgrid.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/date_from"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/button_date_to"
                    style="@style/Widget.Microgrid.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/date_to"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/button_clear_filters"
                    style="@style/Widget.Microgrid.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/clear_filters"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_list_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/muted_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/error_text"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_retry"
                style="@style/Widget.Microgrid.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_error_retry"
                android:textAllCaps="false"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_reservations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
