<?xml version="1.0" encoding="utf-8"?>
<!--
    File: activity_nearby_nodes.xml
    Project: Smart Solar Microgrid Trading System (SE4040)
    Author: Member D
    Created: 2026-09-28
    Description: List of nearby solar microgrid stations, with a button to view them on a map.
                 (Restyled 2026-09-29: dark theme, gradient CTA button.)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_nearby_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nearby Grid Nodes"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/poppins_bold"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Available solar microgrid stations"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/button_view_map"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:text="View Stations on Map"
        android:textAllCaps="false" />

    <ProgressBar
        android:id="@+id/progress_stations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_station_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/station_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
