<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/text_station_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_station_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_station_capacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_station_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_station_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#334155"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/button_station_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="View Details"
        android:textAllCaps="false" />

</LinearLayout>