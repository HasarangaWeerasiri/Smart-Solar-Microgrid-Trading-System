<?xml version="1.0" encoding="utf-8"?>
<!--
    File: AndroidManifest.xml
    Project: Smart Solar Microgrid Trading System (SE4040)
    Author: Lakshan
    Created: 2026-09-22
    Description: Declares the app's permissions and screens. The INTERNET permission is
                 needed because every piece of data comes from the Web API, and the network
                 security config allows plain HTTP to the development server only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app holds no data of its own, so it must be able to reach the Web API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Android 17 blocks apps from reaching addresses on the local network - including the
        emulator's 10.0.2.2 and a development PC on the same Wi-Fi - until the user allows it.
        This is a runtime permission, so LoginActivity also asks for it before the first call.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Microgrid">

        <!-- The first screen. It forwards to a home screen when a session is already saved. -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sign-up screen for a new prosumer. Reached from the link on the login screen. -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />

        <!-- Home screen for a solar prosumer. -->
        <activity
            android:name=".ui.ProsumerHomeActivity"
            android:exported="false" />

        <!-- Home screen for a Grid Operator. -->
        <activity
            android:name=".ui.OperatorHomeActivity"
            android:exported="false" />

    </application>

</manifest>
