# Copy this file to .env and adjust if your API runs somewhere else.
# .env is git-ignored so each member can point at their own API.

# Base address of the C# Web API.
# Local development default:
VITE_API_BASE_URL=http://localhost:5288

# When the API is published to IIS, use that address instead, for example:
# VITE_API_BASE_URL=http://localhost/MicrogridApi
