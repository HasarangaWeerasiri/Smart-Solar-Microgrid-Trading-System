# Copy this file to .env and adjust if your API runs somewhere else.
# .env is git-ignored so each member can point at their own API.

# Base address of the C# Web API.
# http://localhost:5288 is the address when the API runs via `dotnet run`.
# http://localhost:8080 is the address when the API is hosted on IIS (current default).
VITE_API_BASE_URL=http://localhost:8080
